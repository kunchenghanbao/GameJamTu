    "customPhraseDescTS": "// 根据属性名称值编写自定义短语描述，如：\"我的短语是\"+attrs.xxx\n// 使用下拉框组件的变量attrs.xxx有对应的attrs.xxxItems的属性以便获得标签名集合\n// 获取自定义模块的数据名称的函数：getModuleDataName(moduleID:number,dataID:number):string;\n// 获取各种列表内数据名称的函数：getTypeDataListName(typeID: number, dataID: number):string;\n// -- typeID ：0-全局变量 1-全局开关 2-全局字符串 3-玩家变量 4-玩家开关 5-玩家字符串\n//           ：6-场景列表 7-场景对象模型列表 8-图块列表 9-行走图列表 10-行走图动作列表 11-立绘列表 12-立绘表情列表\n//           ：13-公共事件 14-对话框列表 15-动画列表 16-动画信号列表 17-界面列表 18-数据结构列表 19-自定义模块列表\n//           ：20-自定义命令列表 21-自定义行为列表 22-自动元件列表 23-行走图部件列表 24-立绘部件列表\nvar str;\nif (attrs.type == 0) {\n    str = attrs.typeItems[attrs.type];\n}\nelse if (attrs.type == 1) {\n    str = `拥有「${attrs.itemID}-${getModuleDataName(1, attrs.itemID)}」的数目`;\n}\nelse if (attrs.type == 2) {\n    let mapping = { 0: 3, 1: 5, 2: 4 };\n    if (attrs.playerData.selectMode == 1) {\n        let mode = attrs.playerData.inputModeInfo.mode;\n        let constName = attrs.playerData.inputModeInfo.constName;\n        let varNameIndex = attrs.playerData.inputModeInfo.varNameIndex;\n        let varName = mode == 0 ? constName : `[@${varNameIndex}-${getTypeDataListName(mapping[varNameIndex], varNameIndex)}]`;\n        str = `属性「${varName}」`;\n    }\n    else {\n        str = `属性「${attrs.playerData.varName}」`;\n    }\n}\nelse if (attrs.type == 3) {\n    str = `拥有角色`;\n    str += attrs.actorUseVar ? `「${attrs.actorIDVarID}-${getTypeDataListName(3, attrs.actorIDVarID)}」` : `「${attrs.actorID}-${getModuleDataName(6, attrs.actorID)}」`;\n    str += `的数目`;\n}\nelse if (attrs.type == 4) {\n    str = \"\";\n    switch (attrs.actorCheckType) {\n        case 0:\n            str += `玩家队伍角色`;\n            str += attrs.actorUseVar ? `「${attrs.actorIDVarID}-${getTypeDataListName(3, attrs.actorIDVarID)}」` : `「${attrs.actorID}-${getModuleDataName(6, attrs.actorID)}」`;\n            break;\n        case 1:\n            str += \"玩家队伍位置\"\n            str += attrs.actorInPartyIndexVarIDUseVar ? `「${attrs.actorInPartyIndexVarID}-${getTypeDataListName(3, attrs.actorInPartyIndexVarID)}」` : `「${attrs.actorInPartyIndex}」`;\n            str += \"的角色\"\n            break;\n    }\n    str += \" =>\"\n\n    if (attrs.actorAttrName == 23) {\n        str += `「E${attrs.extendAttribute}-${getModuleDataName(14, attrs.extendAttribute)}」`;\n    }\n    else if (attrs.actorAttrName == 19) {\n        str += `「${attrs.actorAttrNameItems[attrs.actorAttrName]}-${attrs.actorCustomAttr.varName}」`;\n    }\n    else {\n        str += `「${attrs.actorAttrNameItems[attrs.actorAttrName]}」`;\n    }\n    if (attrs.trend && ((attrs.actorAttrName >= 7 && attrs.actorAttrName <= 14) || [3, 4, 18, 23].indexOf(attrs.actorAttrName) != -1)) {\n        str += `（变化趋势）`;\n    }\n}\nelse if (attrs.type == 5) {\n    str = attrs.typeItems[attrs.type];\n}\nstr;",
    "customPhraseDescJS": "var str;\nif (attrs.type == 0) {\n    str = attrs.typeItems[attrs.type];\n}\nelse if (attrs.type == 1) {\n    str = \"\\u62E5\\u6709\\u300C\" + attrs.itemID + \"-\" + getModuleDataName(1, attrs.itemID) + \"\\u300D\\u7684\\u6570\\u76EE\";\n}\nelse if (attrs.type == 2) {\n    var mapping = { 0: 3, 1: 5, 2: 4 };\n    if (attrs.playerData.selectMode == 1) {\n        var mode = attrs.playerData.inputModeInfo.mode;\n        var constName = attrs.playerData.inputModeInfo.constName;\n        var varNameIndex = attrs.playerData.inputModeInfo.varNameIndex;\n        var varName = mode == 0 ? constName : \"[@\" + varNameIndex + \"-\" + getTypeDataListName(mapping[varNameIndex], varNameIndex) + \"]\";\n        str = \"\\u5C5E\\u6027\\u300C\" + varName + \"\\u300D\";\n    }\n    else {\n        str = \"\\u5C5E\\u6027\\u300C\" + attrs.playerData.varName + \"\\u300D\";\n    }\n}\nelse if (attrs.type == 3) {\n    str = \"\\u62E5\\u6709\\u89D2\\u8272\";\n    str += attrs.actorUseVar ? \"\\u300C\" + attrs.actorIDVarID + \"-\" + getTypeDataListName(3, attrs.actorIDVarID) + \"\\u300D\" : \"\\u300C\" + attrs.actorID + \"-\" + getModuleDataName(6, attrs.actorID) + \"\\u300D\";\n    str += \"\\u7684\\u6570\\u76EE\";\n}\nelse if (attrs.type == 4) {\n    str = \"\";\n    switch (attrs.actorCheckType) {\n        case 0:\n            str += \"\\u73A9\\u5BB6\\u961F\\u4F0D\\u89D2\\u8272\";\n            str += attrs.actorUseVar ? \"\\u300C\" + attrs.actorIDVarID + \"-\" + getTypeDataListName(3, attrs.actorIDVarID) + \"\\u300D\" : \"\\u300C\" + attrs.actorID + \"-\" + getModuleDataName(6, attrs.actorID) + \"\\u300D\";\n            break;\n        case 1:\n            str += \"玩家队伍位置\";\n            str += attrs.actorInPartyIndexVarIDUseVar ? \"\\u300C\" + attrs.actorInPartyIndexVarID + \"-\" + getTypeDataListName(3, attrs.actorInPartyIndexVarID) + \"\\u300D\" : \"\\u300C\" + attrs.actorInPartyIndex + \"\\u300D\";\n            str += \"的角色\";\n            break;\n    }\n    str += \" =>\";\n    if (attrs.actorAttrName == 23) {\n        str += \"\\u300CE\" + attrs.extendAttribute + \"-\" + getModuleDataName(14, attrs.extendAttribute) + \"\\u300D\";\n    }\n    else if (attrs.actorAttrName == 19) {\n        str += \"\\u300C\" + attrs.actorAttrNameItems[attrs.actorAttrName] + \"-\" + attrs.actorCustomAttr.varName + \"\\u300D\";\n    }\n    else {\n        str += \"\\u300C\" + attrs.actorAttrNameItems[attrs.actorAttrName] + \"\\u300D\";\n    }\n    if (attrs.trend && ((attrs.actorAttrName >= 7 && attrs.actorAttrName <= 14) || [3, 4, 18, 23].indexOf(attrs.actorAttrName) != -1)) {\n        str += \"\\uFF08\\u53D8\\u5316\\u8D8B\\u52BF\\uFF09\";\n    }\n}\nelse if (attrs.type == 5) {\n    str = attrs.typeItems[attrs.type];\n}\nstr;\n"
}