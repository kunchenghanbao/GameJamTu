                        "arrayLength": 100,
                        "arrayAllowDelete": false,
                        "arrayAllowSwap": false,
                        "arrayAllowUpdate": false,
                        "accessMode": 1,
                        "syncMode": 0,
                        "attrTips": "\\n可用于技能或状态击中时的事件自定义编写逻辑或「世界设定」切换成统一的「自定义伤害计算模式」\\n可以在界面自行添加角色的扩展属性用于显示（游戏数值）。\\n百分比加法：如20表示+20%，多个属性叠加，20%+30%+40%=90%\\n百分比乘法：如120%表示*120%，多个属性相乘，120%*130%=156%\\n先计算固定数值相加，然后计算百分比加法，最后计算百分比乘法。\\n比如：\\nA技能的「精神力」的固定数值100，百分比加法20%，百分比乘法140%\\nB技能的「精神力」的固定数值50，百分比加法30%，百分比乘法70%\\n最终角色的「精神力」=(100+50)*(1+20%+30%)*(140%*70%)=220.5",
                        "alias": "扩展属性",
                        "onlyConfig": false,
                        "preview": false,
                        "autoTitleWidth": true,
                        "titleWidth": 100,
                        "eyeShow": true,
                        "lockBlock": false,
                        "enumEnable_get": true,
                        "enumEnable_set": true
                    },
