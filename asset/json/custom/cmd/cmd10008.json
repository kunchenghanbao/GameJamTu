    "isCustomPhraseDesc": true,
    "customPhraseDescTS": "// 根据属性名称值编写自定义短语描述，如：\"我的短语是\"+attrs.xxx\n// 使用下拉框组件的变量attrs.xxx有对应的attrs.xxxItems的属性以便获得标签名集合\n// 获取自定义模块的数据名称的函数：getModuleDataName(moduleID:number,dataID:number):string;\n// 获取各种列表内数据名称的函数：getTypeDataListName(typeID: number, dataID: number):string;\n// -- typeID ：0-全局变量 1-全局开关 2-全局字符串 3-玩家变量 4-玩家开关 5-玩家字符串\n//           ：6-场景列表 7-场景对象模型列表 8-图块列表 9-行走图列表 10-行走图动作列表 11-立绘列表 12-立绘表情列表\n//           ：13-公共事件 14-对话框列表 15-动画列表 16-动画信号列表 17-界面列表 18-数据结构列表 19-自定义模块列表\n//           ：20-自定义命令列表 21-自定义行为列表 22-自动元件列表 23-行走图部件列表 24-立绘部件列表 25-材质列表\nvar str = \"\";\nswitch (attrs.actorCheckType) {\n    case 0:\n        str += `玩家队伍角色`;\n        str += attrs.useVar ? `「${attrs.actorIDVarID}-${getTypeDataListName(3, attrs.actorIDVarID)}」` : `「${attrs.actorID}-${getModuleDataName(6, attrs.actorID)}」`;\n        break;\n    case 1:\n        str += \"玩家队伍位置\"\n        str += attrs.actorInPartyIndexVarIDUseVar ? `「${attrs.actorInPartyIndexVarID}-${getTypeDataListName(3, attrs.actorInPartyIndexVarID)}」` : `「${attrs.actorInPartyIndex}」`;\n        str += \"的角色\"\n        break;\n    case 2:\n        str += \"场景对象-\";\n        str += attrs.soTypeItems[attrs.soType];\n        if (attrs.soType == 2) {\n            str += \":\";\n            if (attrs.soUseVar) {\n                str += ` [${attrs.noVarID}-${getTypeDataListName(3, attrs.noVarID)}]`;\n            }\n            else {\n                str += ` ${attrs.no}号`;\n            }\n        }\n        str += \"对应的角色\"\n        break;\n}\n\nstr += \" \" + attrs.symbolItems[attrs.symbol] + \"\";\nif ((attrs.symbol != 0 && attrs.symbol != 2 && attrs.symbol != 4) || attrs.symbol == 0) {\n    str += \"-\";\n    str += attrs.itemUseVar ? `「${attrs.itemIDVarID}-${getTypeDataListName(3, attrs.itemIDVarID)}」` : `「${attrs.itemID}-${getModuleDataName(1, attrs.itemID)}」`;\n}\n\n// 从玩家背包中穿戴\nif (attrs.symbol == 0 && attrs.fromPlayerPackage) {\n    str += \"（从玩家背包中装上）\";\n}\n// 卸下的装备编号储存至数值变量、\nif ((attrs.symbol == 1 || attrs.symbol == 3) && attrs.isTakeOffItemSaveToVar) {\n    str += `\\n 卸下的道具编号储存至[${attrs.takeOffItemSaveToVar}-${getTypeDataListName(3, attrs.takeOffItemSaveToVar)}]`;\n}\nstr;",
    "customPhraseDescJS": "var str = \"\";\nswitch (attrs.actorCheckType) {\n    case 0:\n        str += \"\\u73A9\\u5BB6\\u961F\\u4F0D\\u89D2\\u8272\";\n        str += attrs.useVar ? \"\\u300C\" + attrs.actorIDVarID + \"-\" + getTypeDataListName(3, attrs.actorIDVarID) + \"\\u300D\" : \"\\u300C\" + attrs.actorID + \"-\" + getModuleDataName(6, attrs.actorID) + \"\\u300D\";\n        break;\n    case 1:\n        str += \"玩家队伍位置\";\n        str += attrs.actorInPartyIndexVarIDUseVar ? \"\\u300C\" + attrs.actorInPartyIndexVarID + \"-\" + getTypeDataListName(3, attrs.actorInPartyIndexVarID) + \"\\u300D\" : \"\\u300C\" + attrs.actorInPartyIndex + \"\\u300D\";\n        str += \"的角色\";\n        break;\n    case 2:\n        str += \"场景对象-\";\n        str += attrs.soTypeItems[attrs.soType];\n        if (attrs.soType == 2) {\n            str += \":\";\n            if (attrs.soUseVar) {\n                str += \" [\" + attrs.noVarID + \"-\" + getTypeDataListName(3, attrs.noVarID) + \"]\";\n            }\n            else {\n                str += \" \" + attrs.no + \"\\u53F7\";\n            }\n        }\n        str += \"对应的角色\";\n        break;\n}\nstr += \" \" + attrs.symbolItems[attrs.symbol] + \"\";\nif ((attrs.symbol != 0 && attrs.symbol != 2 && attrs.symbol != 4) || attrs.symbol == 0) {\n    str += \"-\";\n    str += attrs.itemUseVar ? \"\\u300C\" + attrs.itemIDVarID + \"-\" + getTypeDataListName(3, attrs.itemIDVarID) + \"\\u300D\" : \"\\u300C\" + attrs.itemID + \"-\" + getModuleDataName(1, attrs.itemID) + \"\\u300D\";\n}\nif (attrs.symbol == 0 && attrs.fromPlayerPackage) {\n    str += \"（从玩家背包中装上）\";\n}\nif ((attrs.symbol == 1 || attrs.symbol == 3) && attrs.isTakeOffItemSaveToVar) {\n    str += \"\\n \\u5378\\u4E0B\\u7684\\u9053\\u5177\\u7F16\\u53F7\\u50A8\\u5B58\\u81F3[\" + attrs.takeOffItemSaveToVar + \"-\" + getTypeDataListName(3, attrs.takeOffItemSaveToVar) + \"]\";\n}\nstr;\n"
